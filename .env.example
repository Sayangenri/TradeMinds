# Network: "mainnet" (default) or "testnet"
NETWORK=mainnet

# Mode: "paper" (default), "live", or "simulate" (paper + fake price movements for demo)
MODE=paper

# AI provider: "anthropic" (default) or "openrouter"
AI_PROVIDER=openrouter

# For AI signals (set one based on provider — falls back to rule-based without it)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# For live trading (required only in live mode)
PRIVATE_KEY=
# HSKSwap V3 Router (default is mainnet, override for testnet)
SWAP_ROUTER=0x56d15cF00b5D853D6eE4CbB1463E6DAD2899fBf5

# AI model override (optional)
AI_MODEL=claude-sonnet-4-20250514
